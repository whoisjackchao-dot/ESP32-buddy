# 目标芯片锁定 ESP32-S3（StickS3 = ESP32-S3-PICO-1-N8R8）
CONFIG_IDF_TARGET="esp32s3"

# 8MB Flash / 8MB Octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# 控制台走 USB-Serial-JTAG（与烧录同口，日志可见）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 日志等级：默认 INFO，便于 M1 观察启动报告
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# App 需容纳 WiFi/lwip：2MB 自定义分区（NVS 偏移保持 0x9000，统计不丢）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# HTTPS 证书捆绑（PTT：智谱 ASR esp_crt_bundle_attach 校验用）
# 注意：仅改 defaults 不影响已存在的 D:\buddy_flash\firmware\sdkconfig，
# 该机构建前需同步此行（或删除旧 sdkconfig 让其重新生成）。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# M16 B1：BLE 广播基线（NimBLE，仅广播；与 WiFi STA 共存）
CONFIG_BT_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_NIMBLE_ENABLED=y
